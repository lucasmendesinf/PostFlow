APP_NAME=PostFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postflow
DB_USERNAME=postflow
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PostFlow
# Chave AES-256 dos tokens do Instagram (fora do banco). Gere com: php artisan postflow:token-key
POSTFLOW_TOKEN_KEY=
POSTFLOW_QUEUE_CONTENT=content
POSTFLOW_QUEUE_RENDER=render
POSTFLOW_QUEUE_PUBLISH=publish
POSTFLOW_RENDERER_URL=http://127.0.0.1:3001
# Na hospedagem com cPanel, em vez da URL: o renderizador por linha de comando (deixe POSTFLOW_RENDERER_URL vazio)
# POSTFLOW_RENDERER_CMD="/opt/alt/alt-nodejs22/root/usr/bin/node /home/conta/postflow/workers/renderer/cli.js"

# Claude (geracao da legenda e da arte). Padrao: o modelo mais barato.
ANTHROPIC_API_KEY=
POSTFLOW_CLAUDE_MODELO=claude-haiku-5-5
POSTFLOW_CLAUDE_ESFORCO=medium
# Ciclo automatico: horas de antecedencia para gerar os posts das agendas e minutos antes do horario para expirar sem aprovacao
POSTFLOW_ANTECEDENCIA_HORAS=12
POSTFLOW_EXPIRA_MINUTOS=60
POSTFLOW_PREPROCESSOR_URL=http://127.0.0.1:3002

# Instagram API com Business Login for Instagram (developers.facebook.com > app > Instagram > Configuração da API com login do Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Precisa ser HTTPS e estar cadastrada no app Meta, igual caractere por caractere.
INSTAGRAM_REDIRECT_URI=https://postflow.calutec.com.br/api/v1/instagram/callback
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_REFRESH_WINDOW_DAYS=10
